{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["chrome", "node"],
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["src/**/*.ts", "teste/**/*.ts"]
}
